{
  "name": "stabstab",
  "productName": "StabStab",
  "version": "1.0.0",
  "description": "StabStab - AI 图像生成与编辑工作台（文生图 / 图生图）",
  "author": {
    "name": "StabStab Studio",
    "email": "stabstab@example.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/stabstab/stabstab-studio",
  "main": "electron/main.js",
  "private": true,
  "desktopName": "stabstab",
  "scripts": {
    "dev": "concurrently -k -n renderer,electron -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && cross-env NODE_ENV=development VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "vite build",
    "build:linux": "npm run build && electron-builder --linux",
    "build:win": "npm run build && electron-builder --win",
    "test:api": "node scripts/test-api.js",
    "check:icons": "node scripts/check-icons.js",
    "logo": "node scripts/gen-logo.js",
    "rebuild": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "lightningcss": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  }
}
